{
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "generate": "node tools/generate-manifests.mjs",
    "check:manifests": "node tools/generate-manifests.mjs --check && node tools/test-manifests.mjs",
    "test:node": "node --test",
    "validate": "node tools/validate.mjs",
    "test": "npm run check:manifests && npm run test:node && npm run validate",
    "start": "node tools/start.mjs",
    "build:static": "npm run build:ai && node tools/build-static.mjs",
    "deploy": "npm run build:static && npx wrangler@4.129.0 deploy",
    "build:ai": "node tools/build-ai.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
